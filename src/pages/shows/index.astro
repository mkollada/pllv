---
import GlobalLayout from '../../layouts/GlobalLayout.astro'
---

<GlobalLayout>
  <div class="font-sans px-4 pt-4 md:px-8">
    <div class="flex flex-col items-center">
      <h2 class="font-bold">Upcoming Shows</h2>
      <div class="py-4 md:py-4">
        <ul class="list-item pl-5 font-bold">
          <li class="py-2">
            - 7/11 Porchlight Presents: Live at Cassette - <a
              href="hhttps://link.dice.fm/g99b3cd1853b"
              target="_blank"
              rel="noopener noreferrer"
              class="py-2 underline hover:text-blue-700">Invite</a
            >
            <a
              href="https://link.dice.fm/g99b3cd1853b"
              target="_blank"
              rel="noopener noreferrer"
              class="py-2 underline hover:text-blue-700"
            >
              <div class="w-full max-w-full flex justify-center items-center py-4">
                <img
                  src="https://pihovfuuvvf4hivn.public.blob.vercel-storage.com/july11-cassette-poster.jpg"
                  alt="Cassette Poster"
                  loading="lazy"
                  decoding="async"
                  class="py-2 max-w-100 object-contain transition-transform duration-200 group-hover:scale-[1.02]"
                />
              </div>
            </a>
          </li>
          <li>
            - 7/25 Porchlight Presents: Live at Cassette -
            <a
              href="https://link.dice.fm/Id6dcbc58936"
              target="_blank"
              rel="noopener noreferrer"
              class="underline hover:text-blue-700">Tickets</a
            >
            <a
              href="https://link.dice.fm/Id6dcbc58936"
              target="_blank"
              rel="noopener noreferrer"
              class="underline hover:text-blue-700"
            >
              <div class="w-full max-w-full flex justify-center items-center py-4">
                <img
                  src="https://pihovfuuvvf4hivn.public.blob.vercel-storage.com/july25-cassette-poster.jpeg"
                  alt="Cassette Poster"
                  loading="lazy"
                  decoding="async"
                  class="py-2 max-w-100 object-contain transition-transform duration-200 group-hover:scale-[1.02]"
                />
              </div>
            </a>
          </li>
        </ul>
        <div class="flex flex-col items-center pt-8">
          <p class="">
            Wanna play a show with us? Have a space you think would be a great fit for one of our
            shows? Send us an email at <a
              href="mailto:porchlightpresents@gmail.com"
              target="_blank"
              rel="noopener noreferrer"
              class="underline hover:text-blue-700">porchlightpresents@gmail.com</a
            > or message us on instagram <a
              href="https://www.instagram.com/porchlight.presents/"
              target="_blank"
              rel="noopener noreferrer"
              class="underline hover:text-blue-700">@porchlight.presents</a
            >
          </p>
        </div>
      </div>
    </div>
  </div>
</GlobalLayout>
